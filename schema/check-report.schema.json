{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/garagon/aguara/main/schema/check-report.schema.json",
  "title": "Aguara check JSON report",
  "description": "Output of `aguara check --format json`, schema_version 1.x. The schema is open: consumers must ignore properties they do not know, because minor versions add properties.",
  "allOf": [
    {
      "$ref": "#/definitions/reportHeader"
    },
    {
      "$ref": "#/definitions/checkResult"
    },
    {
      "required": [
        "coverage"
      ]
    }
  ],
  "definitions": {
    "reportHeader": {
      "type": "object",
      "required": [
        "schema_version",
        "tool",
        "catalog"
      ],
      "properties": {
        "schema_version": {
          "description": "Report contract version, major.minor. Additive changes bump the minor version; removals, renames and type changes bump the major version.",
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "tool": {
          "$ref": "#/definitions/toolInfo"
        },
        "catalog": {
          "$ref": "#/definitions/catalogInfo"
        }
      }
    },
    "toolInfo": {
      "description": "The build that produced the report.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "aguara"
          ]
        },
        "version": {
          "description": "Release version such as v0.29.0, or dev for an unversioned build.",
          "type": "string"
        },
        "commit": {
          "description": "Source commit, when known.",
          "type": "string"
        }
      }
    },
    "catalogInfo": {
      "description": "The rule catalog the report used.",
      "type": "object",
      "required": [
        "detections",
        "pattern_rules",
        "analyzer_rules",
        "digest"
      ],
      "properties": {
        "detections": {
          "description": "Rules in the effective catalog: pattern plus analyzer rules, after disabled rules are removed.",
          "type": "integer",
          "minimum": 0
        },
        "pattern_rules": {
          "description": "Compiled YAML pattern rules (rules_loaded).",
          "type": "integer",
          "minimum": 0
        },
        "analyzer_rules": {
          "description": "Analyzer-emitted rules.",
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "description": "SHA-256 of the canonical effective catalog; changes when any rule is added, removed, disabled, re-rated or edited.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "packageFinding": {
      "type": "object",
      "required": [
        "severity",
        "title",
        "detail"
      ],
      "properties": {
        "severity": {
          "description": "CRITICAL, WARNING or INFO. For --fail-on, CRITICAL is critical, WARNING is high and INFO is info.",
          "type": "string",
          "enum": [
            "CRITICAL",
            "WARNING",
            "INFO"
          ]
        },
        "kind": {
          "description": "Finding class: compromised_package, cached_package, cached_artifact, pth_executable, pth_oversized, persistence_artifact or unresolved_include; new classes may be added. SARIF rule IDs are CHECK_ and the upper-cased kind.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "path": {
          "description": "File or directory the finding is about, as discovered (absolute or relative to the working directory).",
          "type": "string"
        },
        "line": {
          "description": "1-based line of the matching entry, for dependency files that have one.",
          "type": "integer",
          "minimum": 1
        },
        "remediation": {
          "type": "string"
        },
        "advisory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ecosystem": {
          "description": "OSV ecosystem of a package finding (npm, PyPI, Go, crates.io, Packagist, RubyGems, Maven, NuGet).",
          "type": "string"
        },
        "package": {
          "description": "Package name as recorded.",
          "type": "string"
        },
        "version": {
          "description": "Version as recorded; absent for an unpinned requirement.",
          "type": "string"
        }
      }
    },
    "credentialFile": {
      "type": "object",
      "required": [
        "path",
        "exists",
        "guidance"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "guidance": {
          "type": "string"
        }
      }
    },
    "intelSummary": {
      "type": "object",
      "required": [
        "mode",
        "snapshot",
        "generated_at",
        "age_days",
        "sources",
        "stale"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "offline",
            "online"
          ]
        },
        "snapshot": {
          "description": "embedded, local, local-verified, remote-fresh or remote-unverified.",
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "age_days": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "ecosystemResult": {
      "type": "object",
      "required": [
        "ecosystem",
        "path",
        "source",
        "packages_read",
        "findings_count"
      ],
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "packages_read": {
          "type": "integer",
          "minimum": 0
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpinned": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_includes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceSummary": {
      "type": "object",
      "required": [
        "ecosystem",
        "source",
        "targets",
        "packages_read"
      ],
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "targets": {
          "type": "integer",
          "minimum": 0
        },
        "packages_read": {
          "type": "integer",
          "minimum": 0
        },
        "unpinned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unsupportedEvidence": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "ecosystem"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        }
      }
    },
    "unresolvedInclude": {
      "type": "object",
      "required": [
        "path",
        "line",
        "argument",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "argument": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "packageCoverage": {
      "type": "object",
      "required": [
        "package_evidence",
        "unsupported_evidence",
        "unresolved_includes"
      ],
      "properties": {
        "package_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidenceSummary"
          }
        },
        "unsupported_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unsupportedEvidence"
          }
        },
        "unresolved_includes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unresolvedInclude"
          }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "required": [
        "environment",
        "findings",
        "credentials",
        "packages_read",
        "pth_scanned",
        "intel",
        "ecosystems"
      ],
      "properties": {
        "environment": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/packageFinding"
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/credentialFile"
          }
        },
        "packages_read": {
          "type": "integer",
          "minimum": 0
        },
        "pth_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "intel": {
          "$ref": "#/definitions/intelSummary"
        },
        "ecosystems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ecosystemResult"
          }
        },
        "coverage": {
          "$ref": "#/definitions/packageCoverage"
        }
      }
    }
  }
}
